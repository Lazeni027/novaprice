                alimentationSupplementaire: false,
                supportMural: false,
                installation: false
            },
            clientName: '',
            clientPhone: '',
            clientEmail: ''
        };
        
        const cameraSelect = document.getElementById('camera-count');
        const resolutionSelect = document.getElementById('resolution-choice');
        const recorderSelect = document.getElementById('recorder-ports');
        
        if (cameraSelect) cameraSelect.value = '4';
        if (resolutionSelect) resolutionSelect.value = "1080p Full HD";
        if (recorderSelect) recorderSelect.value = '4';
        
        for (const key of Object.keys(quoteState.accessories)) {
            const checkbox = document.getElementById(`acc-${key}`);
            if (checkbox) checkbox.checked = false;
        }
        
        const clientNameInput = document.getElementById('client-name');
        const clientPhoneInput = document.getElementById('client-phone');
        const clientEmailInput = document.getElementById('client-email');
        
        if (clientNameInput) clientNameInput.value = '';
        if (clientPhoneInput) clientPhoneInput.value = '';
        if (clientEmailInput) clientEmailInput.value = '';
        
        updateQuoteDisplay();
    }

    function updateQuoteFromInputs() {
        const cameraSelect = document.getElementById('camera-count');
        const resolutionSelect = document.getElementById('resolution-choice');
        const recorderSelect = document.getElementById('recorder-ports');
        
        if (cameraSelect) quoteState.cameraCount = parseInt(cameraSelect.value);
        if (resolutionSelect) quoteState.resolution = resolutionSelect.value;
        if (recorderSelect) quoteState.recorderPorts = parseInt(recorderSelect.value);
        
        for (const key of Object.keys(quoteState.accessories)) {
            const checkbox = document.getElementById(`acc-${key}`);
            if (checkbox) quoteState.accessories[key] = checkbox.checked;
        }
        
        const clientNameInput = document.getElementById('client-name');
        const clientPhoneInput = document.getElementById('client-phone');
        const clientEmailInput = document.getElementById('client-email');
        
        if (clientNameInput) quoteState.clientName = clientNameInput.value;
        if (clientPhoneInput) quoteState.clientPhone = clientPhoneInput.value;
        if (clientEmailInput) quoteState.clientEmail = clientEmailInput.value;
        
        updateQuoteDisplay();
    }

