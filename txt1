    function getDiscountPercentage(price, oldPrice) {
        if(!oldPrice) return 0;
        const priceNum = parseInt(price.replace(/[^0-9]/g, ''));
        const oldPriceNum = parseInt(oldPrice.replace(/[^0-9]/g, ''));
        if(isNaN(priceNum) || isNaN(oldPriceNum) || oldPriceNum === 0) return 0;
        return Math.round((1 - priceNum / oldPriceNum) * 100);
    }

