                                            <div><h4 class="text-red-400 font-bold mb-2">Inconvenients</h4><ul class="list-disc pl-5 space-y-1">${product.disadvantages.map(d => `<li>${d}</li>`).join('')}</ul></div>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        `}).join('')}
                    </div>
                    
                    <div class="mt-12 text-center">
                        <button onclick="navigateTo('appareils')" class="bg-purple-600 hover:bg-purple-700 px-8 py-4 rounded-2xl font-bold transition text-lg">
                            Voir tous nos appareils
                        </button>
                    </div>
                </div>
            </section>

            <section class="py-16 px-6 bg-gray-800">
                <div class="max-w-7xl mx-auto">
                    <div class="flex justify-between items-center mb-6 flex-wrap gap-4">
                        <h2 class="text-4xl font-black">Autres appareils</h2>
                        <button onclick="navigateTo('appareils')" class="bg-blue-600 hover:bg-blue-700 px-6 py-2 rounded-xl transition">
                            Voir tout →
                        </button>
                    </div>
                    <div class="horizontal-scroll">
                        ${autresAppareils.map(app => `
                            <div class="card-appareil bg-gray-800 rounded-2xl overflow-hidden border border-gray-700 hover:border-blue-500 transition flex-shrink-0">
                                <img src="${app.image}" alt="${app.name}" class="w-full h-32 object-cover">
                                <div class="p-3">
                                    <p class="text-xs text-blue-400">${app.code}</p>
                                    <h3 class="font-bold text-sm mt-1 line-clamp-1">${app.name}</h3>
                                    <p class="text-green-400 font-bold text-sm mt-1">${app.price}</p>
                                    <button onclick="commanderWhatsApp('${app.code}', '${app.name}', '${app.price}')" class="w-full bg-green-600 hover:bg-green-700 py-1.5 rounded-lg text-xs font-semibold transition mt-2">
                                        Commander
                                    </button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            </section>

            <section class="py-16 px-6 max-w-7xl mx-auto">
                <div class="bg-gradient-to-r from-blue-800 to-blue-900 rounded-3xl p-8 shadow-2xl">
                    <h2 class="text-4xl font-black mb-8 text-center">Kits Professionnels</h2>
                    <div class="hidden md:block overflow-x-auto bg-white text-black rounded-2xl">
                        <table class="w-full border-collapse">
                            <thead><tr class="bg-gray-100 text-left"><th class="p-4">Kit</th><th class="p-4">Cameras</th><th class="p-4">Enregistreur</th><th class="p-4">Stockage</th><th class="p-4">Prix</th><th class="p-4"></th></tr></thead>
                            <tbody>${kits.map(kit => `<tr class="border-b"><td class="p-4 font-semibold">${kit.title}</td><td class="p-4">${kit.cameras}</td><td class="p-4">${kit.recorder}</td><td class="p-4">${kit.storage}</td><td class="p-4 font-bold text-blue-700">${kit.price}</td><td class="p-4"><button onclick="commanderWhatsApp('KIT${kit.id}', '${kit.title}', '${kit.price}')" class="bg-green-600 text-white px-4 py-1 rounded-lg text-sm hover:bg-green-700">Commander</button></td></tr>`).join('')}</tbody>
                        </table>
                    </div>
                    <div class="md:hidden space-y-4">
                        ${kits.map(kit => `
                            <div class="bg-white text-black rounded-2xl p-5 shadow-lg">
                                <h3 class="text-xl font-bold mb-4 text-blue-700 border-b border-gray-200 pb-2">${kit.title}</h3>
                                <div class="space-y-3"><div class="flex justify-between"><span class="font-semibold text-gray-600">Cameras:</span><span>${kit.cameras}</span></div>
                                <div class="flex justify-between"><span class="font-semibold text-gray-600">Enregistreur:</span><span>${kit.recorder}</span></div>
                                <div class="flex justify-between"><span class="font-semibold text-gray-600">Stockage:</span><span>${kit.storage}</span></div>
                                <div class="flex justify-between pt-3 border-t border-gray-200"><span class="font-semibold text-gray-600">Prix:</span><span class="font-bold text-blue-700 text-lg">${kit.price}</span></div>
                                <button onclick="commanderWhatsApp('KIT${kit.id}', '${kit.title}', '${kit.price}')" class="w-full bg-green-600 text-white py-2 rounded-xl mt-3 hover:bg-green-700">Commander</button></div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            </section>

            <section class="py-16 px-6 max-w-7xl mx-auto">
                <div class="bg-white text-black rounded-3xl p-8 shadow-2xl">
                    <h2 class="text-4xl font-black mb-8 text-center">Tableau Comparatif</h2>
                    <div class="hidden md:block overflow-x-auto">
                        <table class="w-full border-collapse">
                            <thead><tr class="bg-gray-100 text-left"><th class="p-4">Technologie</th><th class="p-4">Resolution</th><th class="p-4">Connexion</th><th class="p-4">Ports/Budget</th><th class="p-4">Usage</th></tr></thead>
                            <tbody>
                                ${comparaisonData.map(item => `<tr class="border-b"><td class="p-4 font-semibold">${item.technologie}</td><td class="p-4">${item.resolution}</td><td class="p-4">${item.connexion}</td><td class="p-4">${item.budget}</td><td class="p-4">${item.usage}</td></tr>`).join('')}
                            </tbody>
                        </table>
                    </div>
                    <div class="md:hidden space-y-4">
                        ${comparaisonData.map(item => `<div class="bg-gray-50 rounded-2xl p-5 border border-gray-200"><div class="space-y-3"><div class="flex justify-between border-b border-gray-200 pb-2"><span class="font-bold text-gray-600">Technologie</span><span class="font-semibold text-right">${item.technologie}</span></div><div class="flex justify-between border-b border-gray-200 pb-2"><span class="font-bold text-gray-600">Resolution</span><span class="text-right">${item.resolution}</span></div><div class="flex justify-between border-b border-gray-200 pb-2"><span class="font-bold text-gray-600">Connexion</span><span class="text-right">${item.connexion}</span></div><div class="flex justify-between border-b border-gray-200 pb-2"><span class="font-bold text-gray-600">Ports/Budget</span><span class="text-right">${item.budget}</span></div><div class="flex justify-between"><span class="font-bold text-gray-600">Usage</span><span class="text-right">${item.usage}</span></div></div></div>`).join('')}
                    </div>
                </div>
            </section>

            <section class="py-16 px-6 bg-gray-900">
                ${renderDevisAutomatique()}
            </section>

            <section id="contact" class="py-20 px-6 bg-black border-t border-gray-800">
                <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <h2 class="text-5xl font-black mb-6 leading-tight">Besoin d'un devis ?</h2>
                        <p class="text-gray-300 text-lg leading-relaxed max-w-2xl">Nova Startup Technologie CI vous accompagne dans vos projets.</p>
                        <div class="mt-6 space-y-3">
                            <p class="text-gray-300">📍 ${companyInfo.siege}</p>
                            <p class="text-gray-300">📞 ${companyInfo.tel}</p>
                            <p class="text-gray-300">💬 Disponible sur WhatsApp</p>
                        </div>
                    </div>
                    <div class="bg-gray-800 border border-gray-700 rounded-3xl p-10 shadow-2xl">
                        <h3 class="text-3xl font-black mb-8">Demande de devis</h3>
                        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Merci ! Nous vous contacterons sur WhatsApp.'); window.open('${companyInfo.whatsappLink}', '_blank');">
                            <input type="text" placeholder="Nom complet" class="w-full bg-gray-700 border border-gray-600 rounded-2xl px-5 py-4 text-white">
                            <input type="text" placeholder="WhatsApp" class="w-full bg-gray-700 border border-gray-600 rounded-2xl px-5 py-4 text-white">
                            <textarea rows="5" placeholder="Description de votre besoin" class="w-full bg-gray-700 border border-gray-600 rounded-2xl px-5 py-4 text-white"></textarea>
                            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 transition py-4 rounded-2xl font-bold text-lg">Envoyer</button>
                        </form>
                    </div>
                </div>
            </section>

            <footer class="bg-black border-t border-gray-800 py-12 px-6">
                <div class="max-w-7xl mx-auto grid md:grid-cols-4 gap-10">
                    <div><h3 class="text-2xl font-black mb-4 text-white">${companyInfo.name}</h3><p class="text-gray-400 leading-relaxed">Specialiste en videosurveillance.</p></div>
                    <div><h4 class="text-xl font-bold mb-4 text-white">Produits</h4><ul class="space-y-3 text-gray-400"><li>Cameras IP</li><li>Cameras Analogiques</li><li>Enregistreurs</li><li>Kits Pro</li></ul></div>
                    <div><h4 class="text-xl font-bold mb-4 text-white">Services</h4><ul class="space-y-3 text-gray-400"><li>Installation</li><li>Maintenance</li><li>Support</li></ul></div>
                    <div><h4 class="text-xl font-bold mb-4 text-white">Contact</h4><ul class="space-y-3 text-gray-400"><li>📍 ${companyInfo.siege}</li><li>📞 ${companyInfo.tel}</li><li>💬 WhatsApp</li></ul></div>
                </div>
                <div class="border-t border-gray-800 mt-12 pt-8 text-center text-gray-500">© 2026 ${companyInfo.name} — Tous droits reserves.</div>
            </footer>
        `;
    }

    function renderApp() {
        let content = '';
        if (currentPage === 'appareils') {
            content = renderAppareilsPage();
        } else if (currentPage === 'realisation') {
            content = renderRealisationPage();
        } else {
            content = renderHomePage();
        }
        
        document.getElementById('app').innerHTML = `
            <nav class="fixed top-0 left-0 right-0 bg-gray-900/95 backdrop-blur-md z-50 border-b border-gray-800">
                <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
                    <button onclick="navigateTo('home')" class="text-left">
                        <h1 class="text-xl font-bold text-blue-400">${companyInfo.name}</h1>
                        <p class="text-xs text-gray-400">${companyInfo.siege}</p>
                    </button>
                    <div class="relative">
                        <button id="menuBtn" class="flex flex-col gap-1.5 p-2 focus:outline-none hover:bg-white/10 rounded-lg transition">
                            <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
                            <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
                            <span class="w-6 h-0.5 bg-white transition-all duration-300"></span>
                        </button>
                        <div id="dropdownMenu" class="absolute right-0 mt-2 w-64 bg-gray-800 rounded-2xl shadow-2xl border border-gray-700 overflow-hidden hidden opacity-0 scale-95 transition-all duration-300 origin-top-right">
                            <div class="py-2">
                                <button onclick="navigateTo('home'); closeMenu()" class="w-full text-left px-5 py-3 hover:bg-blue-600 transition">Accueil</button>
                                <button onclick="scrollToProduits(); closeMenu()" class="w-full text-left px-5 py-3 hover:bg-blue-600 transition">Cameras</button>
                                <button onclick="navigateTo('appareils'); closeMenu()" class="w-full text-left px-5 py-3 hover:bg-blue-600 transition">Appareils</button>
                                <button onclick="scrollToKits(); closeMenu()" class="w-full text-left px-5 py-3 hover:bg-blue-600 transition">Kits Pro</button>
                                <div class="border-t border-gray-700 my-2"></div>
                                <button onclick="window.open('${companyInfo.whatsappLink}', '_blank'); closeMenu()" class="w-full text-left px-5 py-3 hover:bg-green-600 transition">WhatsApp</button>
                                <button onclick="window.location.href='${companyInfo.callLink}'; closeMenu()" class="w-full text-left px-5 py-3 hover:bg-blue-600 transition">Appeler</button>
                                <div class="border-t border-gray-700 my-2"></div>
                                <button onclick="navigateTo('realisation'); closeMenu()" class="w-full text-left px-5 py-3 hover:bg-purple-600 transition">Realisations</button>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
            ${content}
        `;
        
        const menuBtn = document.getElementById('menuBtn');
        const dropdownMenu = document.getElementById('dropdownMenu');
        
        if (menuBtn && dropdownMenu) {
            menuBtn.onclick = (e) => {
                e.stopPropagation();
                dropdownMenu.classList.toggle('hidden');
                dropdownMenu.classList.toggle('opacity-0');
                dropdownMenu.classList.toggle('scale-95');
                dropdownMenu.classList.toggle('opacity-100');
                dropdownMenu.classList.toggle('scale-100');
                menuBtn.classList.toggle('menu-open');
            };
            
            document.addEventListener('click', (e) => {
                if (!menuBtn.contains(e.target) && !dropdownMenu.contains(e.target)) {
                    dropdownMenu.classList.add('hidden', 'opacity-0', 'scale-95');
                    dropdownMenu.classList.remove('opacity-100', 'scale-100');
                    menuBtn.classList.remove('menu-open');
                }
            });
        }
        
        if (currentPage === 'appareils') {
            window.filterAppareils = filterAppareils;
            window.showDetails = showDetails;
        }
        
        window.closeModal = closeModal;
        window.commanderWhatsApp = commanderWhatsApp;
        window.updateQuoteFromInputs = updateQuoteFromInputs;
        window.submitQuoteToWhatsApp = submitQuoteToWhatsApp;
        window.resetQuote = resetQuote;
        
        setTimeout(() => {
            updateQuoteDisplay();
        }, 100);
    }

    window.navigateTo = (page) => {
        currentPage = page;
        renderApp();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };
    
    window.scrollToProduits = () => {
        currentPage = 'home';
        renderApp();
        setTimeout(() => {
            const element = document.getElementById('produits');
            if (element) element.scrollIntoView({ behavior: 'smooth' });
        }, 100);
    };
    
    window.scrollToKits = () => {
        currentPage = 'home';
        renderApp();
        setTimeout(() => {
            const element = document.getElementById('kits');
            if (element) element.scrollIntoView({ behavior: 'smooth' });
        }, 100);
    };
    
    window.closeMenu = () => {
        const dropdownMenu = document.getElementById('dropdownMenu');
        const menuBtn = document.getElementById('menuBtn');
        if (dropdownMenu && menuBtn) {
            dropdownMenu.classList.add('hidden', 'opacity-0', 'scale-95');
            dropdownMenu.classList.remove('opacity-100', 'scale-100');
            menuBtn.classList.remove('menu-open');
        }
    };
    
    renderApp();
</script>

</body>
</html>