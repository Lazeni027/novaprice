    function calculateQuote() {
        const cameraKitPrice = pricingConfig.cameraKits[quoteState.cameraCount].base;
        const recorderPrice = pricingConfig.recorders[quoteState.recorderPorts].price;
        const resolutionMultiplier = pricingConfig.resolutionMultipliers[quoteState.resolution];
        
        let basePrice = (cameraKitPrice + recorderPrice) * resolutionMultiplier;
        
        let accessoriesTotal = 0;
        let selectedAccessories = [];
        
        for (const [key, isSelected] of Object.entries(quoteState.accessories)) {
            if (isSelected && pricingConfig.accessories[key]) {
                accessoriesTotal += pricingConfig.accessories[key].price;
                selectedAccessories.push(pricingConfig.accessories[key].name);
            }
        }
        
        const totalPrice = basePrice + accessoriesTotal;
        
        let budgetCategory = "standard";
        if (totalPrice <= pricingConfig.budgetIntervals.economique.max) {
            budgetCategory = "economique";
        } else if (totalPrice <= pricingConfig.budgetIntervals.standard.max) {
            budgetCategory = "standard";
        } else if (totalPrice <= pricingConfig.budgetIntervals.professionnel.max) {
            budgetCategory = "professionnel";
        } else {
            budgetCategory = "premium";
        }
        
        return {
            cameraCount: quoteState.cameraCount,
            cameraKitName: pricingConfig.cameraKits[quoteState.cameraCount].name,
            cameraKitPrice: cameraKitPrice,
            recorderPorts: quoteState.recorderPorts,
            recorderName: pricingConfig.recorders[quoteState.recorderPorts].name,
            recorderPrice: recorderPrice,
            resolution: quoteState.resolution,
            resolutionMultiplier: resolutionMultiplier,
            accessoriesTotal: accessoriesTotal,
            selectedAccessories: selectedAccessories,
            basePrice: basePrice,
            totalPrice: totalPrice,
            budgetCategory: budgetCategory,
            budgetRange: pricingConfig.budgetIntervals[budgetCategory],
            formattedTotal: new Intl.NumberFormat('fr-FR').format(totalPrice) + ' FCFA'
        };
    }

